  "description": "Read and write design tokens across DTCG, Figma variables, Tokens Studio and Tailwind v4, with a report of what each conversion loses.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "hipuku",
  "homepage": "https://github.com/hipuku/tokenise/tree/main/packages/dtcg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipuku/tokenise.git",
    "directory": "packages/dtcg"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "figma",
    "tokens-studio",
