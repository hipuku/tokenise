{
  "color": {
    "$type": "color",
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.1, 0.1, 0.12] } },
    "brand": {
      "$value": { "colorSpace": "oklch", "components": [0.7, 0.32, 150] },
      "$description": "A green outside the sRGB gamut"
    },
    "text": { "$value": "{color.ink}" }
  },
  "space": {
    "$type": "dimension",
    "md": { "$value": { "value": 1, "unit": "rem" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 150, "unit": "ms" } },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "text": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Inter", "sans-serif"],
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    }
  }
}
